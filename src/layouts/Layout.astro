---
import '../styles/theme.css';
import { SignOutButton } from '@clerk/astro/components';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import AuthInit from '../components/AuthInit.svelte';
import { useTranslations, localizePath, stripLocale, getLangFromUrl, type Lang } from '../i18n';
import { getUserId } from '../lib/auth';

interface Props {
  title: string;
  lang?: Lang;
}

const { title, lang = getLangFromUrl(Astro.url) } = Astro.props;
const t = useTranslations(lang).common;
const currentPath = stripLocale(Astro.url.pathname);
const p = (path: string) => localizePath(path, lang);
const addBookPath = `${p('/biblio')}?add=1`;
const userId = getUserId(Astro.locals as Parameters<typeof getUserId>[0]);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#975d04" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400;1,6..72,500&display=swap"
    />
    <title>{title}</title>
    <script is:inline>
      // Pre-paint theme application — avoids dark-mode flash (FOUC).
      try {
        const saved = localStorage.getItem('biblocal-theme');
        if (saved === 'light' || saved === 'dark') {
          document.documentElement.setAttribute('data-theme', saved);
        }
      } catch (e) {}
    </script>
  </head>
  <body>
    {userId && <AuthInit client:load userId={userId} />}
    <nav class="glass">
      <a href={p('/')} class="logo">biblocal</a>
      <button
        class="hamburger"
        id="nav-toggle"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="nav-links"
      >
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
      </button>
      <div class="links" id="nav-links">
        <a href={p('/biblio')} class:list={{ active: currentPath === '/biblio' }}>{t.appNav.shelf}</a>
        <a href={p('/local')} class:list={{ active: currentPath === '/local' }}>{t.appNav.matches}</a>
        <a href={p('/profile')} class:list={{ active: currentPath === '/profile' }}>{t.appNav.profile}</a>
        <button
          id="theme-toggle"
          class="theme-toggle"
          type="button"
          aria-label="Toggle color theme"
          title="Toggle light / dark"
          data-theme-label={t.appNav.theme}
        >
          <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
          </svg>
          <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
        </button>
        <span class="logout-wrapper"><SignOutButton>{t.appNav.logout}</SignOutButton></span>
        <span class="nav-lang"><LanguageSwitcher /></span>
      </div>
    </nav>
    <slot />
    <nav class="mobile-tabbar glass" aria-label={t.appNav.mobileLabel}>
      <a href={p('/biblio')} class:list={{ active: currentPath === '/biblio' }}>
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" /><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" /></svg>
        <span>{t.appNav.shelf}</span>
      </a>
      <a class="add-tab" href={addBookPath} aria-label={t.appNav.addBook}>
        <span class="add-tab-icon" aria-hidden="true">+</span>
        <span>{t.appNav.add}</span>
      </a>
      <a href={p('/local')} class:list={{ active: currentPath === '/local' }}>
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="8" /><path d="M12 8v4l2.5 2" /></svg>
        <span>{t.appNav.matches}</span>
      </a>
      <a href={p('/profile')} class:list={{ active: currentPath === '/profile' }}>
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="3" /><path d="M5 21a7 7 0 0 1 14 0" /></svg>
        <span>{t.appNav.profile}</span>
      </a>
    </nav>
    <script>
      const navToggle = document.getElementById('nav-toggle');
      const navLinks = document.getElementById('nav-links');

      navToggle?.addEventListener('click', () => {
        const isExpanded = navToggle.getAttribute('aria-expanded') === 'true';
        navToggle.setAttribute('aria-expanded', String(!isExpanded));
        navLinks?.classList.toggle('open');
      });

      document.addEventListener('click', (e) => {
        if (!navToggle?.contains(e.target as Node) && !navLinks?.contains(e.target as Node)) {
          navToggle?.setAttribute('aria-expanded', 'false');
          navLinks?.classList.remove('open');
        }
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          navToggle?.setAttribute('aria-expanded', 'false');
          navLinks?.classList.remove('open');
        }
      });

      // Theme toggle: resolve current effective theme, flip, persist.
      const themeToggle = document.getElementById('theme-toggle');
      themeToggle?.addEventListener('click', () => {
        const root = document.documentElement;
        const explicit = root.getAttribute('data-theme');
        const systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const effective = explicit ?? (systemDark ? 'dark' : 'light');
        const next = effective === 'dark' ? 'light' : 'dark';
        root.setAttribute('data-theme', next);
        try { localStorage.setItem('biblocal-theme', next); } catch (e) {}
      });
    </script>
  </body>
</html>

<style>
  nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--s-4);
    padding: 0.7rem clamp(1rem, 4vw, 2rem);
    position: sticky;
    top: 0;
    z-index: 100;
    border-bottom: 1px solid var(--hairline);
  }

  .logo {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--ink);
    text-decoration: none;
    transition: color var(--dur-1) var(--ease-soft);
  }
  .logo:hover { color: var(--accent); }

  .links {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .links a {
    padding: 0.5rem 0.9rem;
    font-family: var(--font-ui);
    font-size: 0.9rem;
    font-weight: 540;
    color: var(--ink-muted);
    text-decoration: none;
    border-radius: var(--r-full);
    transition: color var(--dur-1) var(--ease-soft), background var(--dur-2) var(--ease-out);
  }
  .links a:hover { color: var(--ink); background: var(--surface-sunken); }
  .links a.active { color: var(--accent); background: var(--accent-tint); }

  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    margin-left: 0.25rem;
    color: var(--ink-muted);
    background: transparent;
    border: 1px solid var(--hairline);
    border-radius: var(--r-full);
    cursor: pointer;
    transition: color var(--dur-1) var(--ease-soft), background var(--dur-2) var(--ease-out), border-color var(--dur-2) var(--ease-out);
  }
  .theme-toggle:hover { color: var(--accent); border-color: var(--accent); }
  .theme-toggle .icon-moon { display: none; }
  :global([data-theme="dark"]) .theme-toggle .icon-sun { display: none; }
  :global([data-theme="dark"]) .theme-toggle .icon-moon { display: inline; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .theme-toggle .icon-sun { display: none; }
    :global(:root:not([data-theme="light"])) .theme-toggle .icon-moon { display: inline; }
    :global([data-theme="light"]) .theme-toggle .icon-sun { display: inline; }
    :global([data-theme="light"]) .theme-toggle .icon-moon { display: none; }
  }

  .logout-wrapper :global(button) {
    padding: 0.5rem 0.9rem;
    font-family: var(--font-ui);
    font-size: 0.9rem;
    font-weight: 540;
    color: var(--ink-muted);
    background: none;
    border: none;
    border-radius: var(--r-full);
    cursor: pointer;
    transition: color var(--dur-1) var(--ease-soft), background var(--dur-2) var(--ease-out);
  }
  .logout-wrapper :global(button:hover) { color: var(--ink); background: var(--surface-sunken); }

  .hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    padding: 0.5rem;
    background: transparent;
    border: none;
    cursor: pointer;
    z-index: 10;
  }
  .hamburger-line {
    width: 22px;
    height: 2px;
    background: var(--ink);
    border-radius: 2px;
    transition: transform var(--dur-2) var(--ease-spring), opacity var(--dur-1) var(--ease-soft);
  }

  .mobile-tabbar { display: none; }
  .hamburger[aria-expanded="true"] .hamburger-line:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .hamburger[aria-expanded="true"] .hamburger-line:nth-child(2) { opacity: 0; }
  .hamburger[aria-expanded="true"] .hamburger-line:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  @media (max-width: 768px) {
    :global(body) { padding-bottom: calc(72px + env(safe-area-inset-bottom)); }
    .hamburger { display: flex; }
    .links {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 0;
      /* Opaque surface so the menu is legible even where backdrop-filter
         isn't composited (mobile Safari/Firefox/reduced-GPU). Blur stays
         as a progressive enhancement layered on top. */
      background: var(--surface);
      -webkit-backdrop-filter: blur(20px) saturate(1.8);
      backdrop-filter: blur(20px) saturate(1.8);
      border-bottom: 1px solid var(--hairline);
      max-height: 0;
      overflow: hidden;
      opacity: 0;
      /* Closed menu is hidden from keyboard/AT focus, not just visually faded. */
      visibility: hidden;
      transition: max-height var(--dur-3) var(--ease-out), opacity var(--dur-2) var(--ease-soft), padding var(--dur-3) var(--ease-out), visibility var(--dur-3) var(--ease-out);
    }
    .links.open { max-height: 360px; opacity: 1; padding: 0.5rem; visibility: visible; }
    .links a, .logout-wrapper :global(button) {
      padding: 0.875rem 1rem;
      border-radius: var(--r-md);
      min-height: 44px;
      display: flex;
      align-items: center;
      width: 100%;
    }
    .theme-toggle { width: 100%; height: 44px; justify-content: flex-start; padding-left: 1rem; border: none; gap: 0.6rem; }
    .theme-toggle::after { content: attr(data-theme-label); font-size: 0.9rem; font-weight: 540; }
    .nav-lang { padding: 0.5rem 1rem; }

    .mobile-tabbar {
      position: fixed;
      display: flex;
      align-items: flex-end;
      justify-content: space-around;
      gap: 0.15rem;
      inset: auto 0 0;
      z-index: 90;
      min-height: 66px;
      padding: 0.35rem max(var(--s-2), env(safe-area-inset-right)) calc(0.35rem + env(safe-area-inset-bottom)) max(var(--s-2), env(safe-area-inset-left));
      border-top: 1px solid var(--hairline);
      box-shadow: 0 -8px 24px oklch(0.28 0.025 55 / 0.08);
    }
    .mobile-tabbar a {
      display: inline-flex;
      flex: 1 1 0;
      min-width: 0;
      min-height: 52px;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 0.15rem;
      color: var(--ink-muted);
      font-family: var(--font-ui);
      font-size: 0.6875rem;
      font-weight: 590;
      text-decoration: none;
    }
    .mobile-tabbar a.active { color: var(--accent); }
    .mobile-tabbar .add-tab { color: var(--accent-on); }
    .add-tab-icon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 38px;
      height: 38px;
      margin-top: -1rem;
      border-radius: var(--r-full);
      background: var(--accent);
      box-shadow: var(--shadow-2);
      font-size: 1.55rem;
      font-weight: 400;
      line-height: 1;
    }
    .add-tab span:last-child { color: var(--accent); }
  }
</style>
