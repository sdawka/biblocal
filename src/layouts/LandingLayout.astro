---
import '../styles/theme.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content="Build your living bookshelf. Find people nearby with similar taste. Borrow, discuss, and discover locally." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400;1,6..72,500&display=swap"
    />
    <title>{title}</title>
    <script is:inline>
      // Pre-paint theme application — avoids dark-mode flash (FOUC).
      try {
        const saved = localStorage.getItem('biblocal-theme');
        if (saved === 'light' || saved === 'dark') {
          document.documentElement.setAttribute('data-theme', saved);
        }
      } catch (e) {}
    </script>
  </head>
  <body class="landing">
    <slot />
  </body>
</html>

<style>
  body.landing {
    overflow-x: hidden;
  }
</style>

<noscript>
  <style>
    /* Make all content visible when JS is disabled */
    .section-title,
    .section-desc,
    .shelf-container,
    .shelf-caption,
    .facets-grid,
    .facets-note,
    .text-content,
    .map-container,
    .mid-cta .cta-link,
    .book-spine,
    .facet-card,
    .map-point .point-dot,
    .map-point .point-label,
    .connection-line {
      opacity: 1 !important;
      transform: none !important;
    }
  </style>
</noscript>
