---
import '../styles/theme.css';
import Seo from '../components/Seo.astro';

import type { Lang } from '../i18n';

interface Props {
  title: string;
  lang?: Lang;
  seo?: {
    description?: string;
    ogImage?: string;
    type?: 'website' | 'article';
    jsonLd?: object[];
  };
}

const { title, seo, lang = 'en' } = Astro.props;
const description =
  seo?.description ??
  'Build your living bookshelf. Find people nearby with similar taste. Borrow, discuss, and discover locally.';
const path = Astro.url.pathname;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#975d04" />
    <Seo
      title={title}
      description={description}
      path={path}
      lang={lang}
      ogImage={seo?.ogImage}
      type={seo?.type}
      jsonLd={seo?.jsonLd}
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400;1,6..72,500&display=swap"
    />
    <script is:inline>
      // Pre-paint theme application — avoids dark-mode flash (FOUC).
      try {
        const saved = localStorage.getItem('biblocal-theme');
        if (saved === 'light' || saved === 'dark') {
          document.documentElement.setAttribute('data-theme', saved);
        }
      } catch (e) {}
    </script>
  </head>
  <body class="landing">
    <slot />
  </body>
</html>

<style>
  body.landing {
    overflow-x: hidden;
  }
</style>
