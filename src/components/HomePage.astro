---
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from './LandingHero.svelte';
import BookshelfDemo from './BookshelfDemo.svelte';
import FacetShowcase from './FacetShowcase.svelte';
import MidPageCTA from './MidPageCTA.svelte';
import LocalMapPreview from './LocalMapPreview.svelte';
import SignInSection from './SignInSection.astro';
import Footer from './Footer.astro';
import { webApplicationJsonLd } from '../lib/seo';
import { useTranslations, type Lang } from '../i18n';

interface Props {
  lang?: Lang;
}
const { lang = 'en' } = Astro.props;
const t = useTranslations(lang).home;
---

<LandingLayout
  lang={lang}
  title={t.meta.title}
  seo={{
    description: t.meta.description,
    organizationDescription: t.meta.description,
    jsonLd: [webApplicationJsonLd(t.meta.description)],
  }}
>
  <main>
    <LandingHero lang={lang} client:load />
    <BookshelfDemo lang={lang} client:visible />
    <LocalMapPreview lang={lang} client:visible />
    <FacetShowcase lang={lang} client:visible />
    <MidPageCTA lang={lang} client:visible />
    <SignInSection lang={lang} />
    <Footer lang={lang} />
  </main>
</LandingLayout>

<style>
  main {
    max-width: none;
    margin: 0;
    padding: 0;
  }
</style>
