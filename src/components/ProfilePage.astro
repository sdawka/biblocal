---
import Layout from '../layouts/Layout.astro';
import ProfileIsland from './ProfileIsland.svelte';
import ConnectionRequestsIsland from './ConnectionRequestsIsland.svelte';
import SyncErrorToast from './SyncErrorToast.svelte';
import { UserButton } from '@clerk/astro/components';
import { env } from 'cloudflare:workers';
import { useTranslations, type Lang } from '../i18n';

interface Props {
  lang?: Lang;
}
const { lang = 'en' } = Astro.props;
const t = useTranslations(lang).profile;

const isQaMode = (env as { QA_MODE?: string })?.QA_MODE === 'true';
---

<Layout lang={lang} title={t.meta.title}>
  <main>
      <div class="header-row rise">
        <h1 class="serif">{t.page.heading}</h1>
        {!isQaMode && <UserButton />}
      </div>

      <SyncErrorToast lang={lang} client:load />

      <ConnectionRequestsIsland client:idle />
      <ProfileIsland lang={lang} client:load />
    </main>
</Layout>

<style>
  .header-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--s-4);
    margin-bottom: var(--s-5);
  }
</style>
