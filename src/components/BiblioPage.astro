---
import Layout from '../layouts/Layout.astro';
import Bookshelf from './Bookshelf.svelte';
import PromptIsland from './PromptIsland.svelte';
import SyncErrorToast from './SyncErrorToast.svelte';
import { UserButton } from '@clerk/astro/components';
import { env } from 'cloudflare:workers';
import { localizePath, useTranslations, type Lang } from '../i18n';

interface Props {
  lang?: Lang;
}
const { lang = 'en' } = Astro.props;
const t = useTranslations(lang).shelf;
const p = (path: string) => localizePath(path, lang);

const isQaMode = (env as { QA_MODE?: string })?.QA_MODE === 'true';
---

<Layout lang={lang} title={t.page.metaTitle}>
  <main class="wide">
      <div class="header-row rise">
        <div class="header-text">
          <p class="eyebrow">{t.page.eyebrow}</p>
          <h1>{t.page.title}</h1>
        </div>
        {!isQaMode && <UserButton signInUrl={p('/')} />}
      </div>

      <SyncErrorToast lang={lang} client:load />

      <PromptIsland lang={lang} client:idle context="shelf" />

      <Bookshelf lang={lang} client:load />
    </main>
</Layout>

<style>
  /* Biblio gets its own wider column so the shelf breathes into the page
     margins; only the side gutter grows, vertical rhythm stays site-wide.
     Astro scopes this, so it never leaks to other routes. */
  main.wide {
    max-width: var(--maxw-shelf);
    padding-inline: clamp(var(--s-5), 5vw, var(--s-8));
    overflow-x: clip;
  }

  /* Header spans the wide column so the eyebrow + H1 stay left-aligned with
     the filter bar and shelf below; the UserButton rides the far right. */
  .header-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--s-4);
    margin-bottom: var(--s-5);
  }

  .header-text .eyebrow {
    margin: 0 0 var(--s-2);
  }

  .header-text h1 {
    margin: 0;
  }
</style>
