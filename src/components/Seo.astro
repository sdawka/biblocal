---
import {
  resolveSeo,
  organizationJsonLd,
  websiteJsonLd,
  SITE_NAME,
  absoluteUrl,
} from '../lib/seo';
import { stripLocale, localizePath, getLanguagesForPath, type Lang } from '../i18n';

interface Props {
  title: string;
  description: string;
  path: string;
  lang?: Lang;
  ogImage?: string;
  type?: 'website' | 'article';
  jsonLd?: object[];
  organizationDescription?: string;
}

const {
  title,
  description,
  path,
  lang = 'en',
  ogImage,
  type,
  jsonLd = [],
  organizationDescription,
} = Astro.props;
const seo = resolveSeo({ title, description, path, ogImage, type });

// hreflang alternates for the same page across locales.
const basePath = stripLocale(path);
const alternates = getLanguagesForPath(basePath).map((l) => ({
  lang: l,
  href: absoluteUrl(localizePath(basePath, l)),
}));
const xDefault = absoluteUrl(localizePath(basePath, 'en'));
const ogLocales: Record<Lang, string> = { en: 'en_US', fr: 'fr_FR', es: 'es_ES' };
const ogLocale = ogLocales[lang];
const ogLocaleAlternates = getLanguagesForPath(basePath)
  .filter((l) => l !== lang)
  .map((l) => ogLocales[l]);

// Site-wide structured data always present; page-specific appended.
const graphs = [organizationJsonLd(organizationDescription), websiteJsonLd(), ...jsonLd];
---

<title>{seo.title}</title>
<meta name="description" content={seo.description} />
<link rel="canonical" href={seo.canonical} />

{alternates.map((a) => (
  <link rel="alternate" hreflang={a.lang} href={a.href} />
))}
<link rel="alternate" hreflang="x-default" href={xDefault} />

<meta property="og:type" content={seo.type} />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:locale" content={ogLocale} />
{ogLocaleAlternates.map((locale) => (
  <meta property="og:locale:alternate" content={locale} />
))}
<meta property="og:title" content={seo.title} />
<meta property="og:description" content={seo.description} />
<meta property="og:url" content={seo.canonical} />
<meta property="og:image" content={seo.ogImage} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={seo.title} />
<meta name="twitter:description" content={seo.description} />
<meta name="twitter:image" content={seo.ogImage} />

{graphs.map((g) => (
  <script type="application/ld+json" set:html={JSON.stringify(g)} />
))}
