---
import { SignIn, Show } from '@clerk/astro/components';
---

<section id="signin-section" class="signin-section">
  <div class="section-content">
    <div class="faded-spines left">
      <div class="spine"></div>
      <div class="spine"></div>
      <div class="spine"></div>
    </div>

    <div class="signin-card">
      <p class="eyebrow">Join biblocal</p>
      <h2 class="section-title">Ready when you are.</h2>
      <p class="section-desc">Add some books. See who's nearby. The rest tends to happen on its own.</p>

      <Show when="signed-out">
        <div class="clerk-container">
          <SignIn />
        </div>
      </Show>
    </div>

    <div class="faded-spines right">
      <div class="spine"></div>
      <div class="spine"></div>
      <div class="spine"></div>
    </div>
  </div>
</section>

<style>
  .signin-section {
    min-height: 80vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--s-10) var(--s-6);
    background: var(--canvas);
    position: relative;
  }

  .section-content {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--s-10);
    max-width: 1000px;
    width: 100%;
  }

  .faded-spines {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    opacity: 0.5;
  }

  .faded-spines.left {
    align-items: flex-end;
  }

  .faded-spines.right {
    align-items: flex-start;
  }

  .spine {
    width: 34px;
    height: 160px;
    background: var(--surface-sunken);
    border: 1px solid var(--hairline);
    border-radius: var(--r-sm);
    box-shadow: var(--shadow-1);
  }

  .faded-spines .spine:nth-child(1) {
    height: 140px;
    transform: rotate(-2deg);
    background: var(--accent-tint);
  }

  .faded-spines .spine:nth-child(2) {
    height: 180px;
  }

  .faded-spines .spine:nth-child(3) {
    height: 150px;
    transform: rotate(1deg);
    background: var(--accent-tint);
  }

  .signin-card {
    text-align: center;
    max-width: 420px;
  }

  .eyebrow {
    margin: 0 0 var(--s-3);
  }

  .section-title {
    font-size: clamp(1.6rem, 3.5vw, 2.2rem);
    margin: 0 0 var(--s-4);
  }

  .section-desc {
    font-family: var(--font-ui);
    font-size: 1rem;
    color: var(--ink-muted);
    line-height: 1.6;
    margin: 0 0 var(--s-7);
  }

  .clerk-container {
    display: flex;
    justify-content: center;
  }

  @media (max-width: 800px) {
    .faded-spines {
      display: none;
    }

    .signin-card {
      max-width: 100%;
    }
  }
</style>
