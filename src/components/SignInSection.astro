---
import { SignIn, Show } from '@clerk/astro/components';
---

<section id="signin-section" class="signin-section" aria-labelledby="signin-title">
  <div class="spines" aria-hidden="true">
    <span class="spine"></span>
    <span class="spine"></span>
    <span class="spine"></span>
    <span class="spine"></span>
    <span class="spine"></span>
    <span class="spine"></span>
    <span class="spine"></span>
    <span class="spine"></span>
  </div>

  <div class="section-content">
    <div class="closer-copy">
      <p class="eyebrow"><span class="rule"></span>Your shelf awaits</p>

      <h2 id="signin-title" class="section-title">
        Ready when<br />
        <em>you are.</em>
      </h2>

      <p class="section-desc">
        Add a few books. See who's nearby. The rest tends to happen
        on its own: quietly, locally, one shared read at a time.
      </p>
    </div>

    <div class="signin-card card">
      <Show when="signed-out">
        <div class="clerk-container">
          <SignIn />
        </div>
      </Show>
    </div>
  </div>
</section>

<style>
  .signin-section {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: clamp(5rem, 12vh, 9rem) clamp(1.25rem, 5vw, 5rem);
    background:
      radial-gradient(50% 60% at 85% 30%, var(--accent-tint) 0%, transparent 70%),
      var(--surface-sunken);
  }

  /* Refined decorative spine band — quiet, clean, anchored to the edge. */
  .spines {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    gap: 0.55rem;
    padding: 0 clamp(1rem, 4vw, 4rem);
    opacity: 0.45;
    pointer-events: none;
    -webkit-mask-image: linear-gradient(to top, #000 0%, transparent 55%);
    mask-image: linear-gradient(to top, #000 0%, transparent 55%);
  }
  .spine {
    width: clamp(20px, 2.4vw, 32px);
    border-top-left-radius: var(--r-sm);
    border-top-right-radius: var(--r-sm);
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-bottom: none;
  }
  .spine:nth-child(1) { height: 32%; }
  .spine:nth-child(2) { height: 46%; background: var(--accent-tint); border-color: transparent; }
  .spine:nth-child(3) { height: 38%; }
  .spine:nth-child(4) { height: 54%; }
  .spine:nth-child(5) { height: 30%; background: var(--accent-tint); border-color: transparent; }
  .spine:nth-child(6) { height: 44%; }
  .spine:nth-child(7) { height: 36%; }
  .spine:nth-child(8) { height: 50%; }

  .section-content {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.95fr);
    align-items: center;
    gap: clamp(2.5rem, 6vw, 5.5rem);
    width: 100%;
    max-width: 1240px;
    margin: 0 auto;
  }

  /* ── Closing copy ───────────────────────────────────── */
  .closer-copy { max-width: 34rem; }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin: 0 0 var(--s-5);
    font-family: var(--font-ui);
    font-size: 0.78rem;
    font-weight: 590;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  .eyebrow .rule {
    width: 30px;
    height: 1.5px;
    background: var(--accent);
    border-radius: 2px;
    flex: none;
  }
  .eyebrow .num { color: var(--accent); }

  .section-title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(2.4rem, 5.5vw, 3.8rem);
    line-height: 1.02;
    letter-spacing: -0.03em;
    color: var(--ink);
    margin: 0 0 var(--s-5);
  }
  .section-title em {
    font-style: italic;
    font-weight: 500;
    color: var(--accent);
  }

  .section-desc {
    font-family: var(--font-ui);
    font-size: 1.15rem;
    color: var(--ink-muted);
    line-height: 1.6;
    max-width: 44ch;
    margin: 0;
  }

  /* ── Clerk sign-in card ─────────────────────────────── */
  .signin-card {
    padding: clamp(1.25rem, 3vw, 2rem);
    border-radius: var(--r-xl);
    box-shadow: var(--shadow-3);
    justify-self: end;
    width: 100%;
    max-width: 440px;
  }

  .clerk-container {
    display: flex;
    justify-content: center;
  }

  @media (max-width: 800px) {
    .section-content {
      grid-template-columns: 1fr;
      gap: clamp(2.5rem, 8vw, 3.5rem);
    }
    .closer-copy { max-width: none; }
    .signin-card { justify-self: stretch; max-width: 480px; margin: 0 auto; }
    .spines { opacity: 0.3; }
  }
</style>
