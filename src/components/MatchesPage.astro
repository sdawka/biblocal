---
import Layout from '../layouts/Layout.astro';
import MatchMapIsland from './MatchMapIsland.svelte';
import PromptIsland from './PromptIsland.svelte';
import QaAuthInit from './QaAuthInit.svelte';
import { UserButton } from '@clerk/astro/components';
import { env } from 'cloudflare:workers';
import { useTranslations, type Lang } from '../i18n';

interface Props {
  lang?: Lang;
}
const { lang = 'en' } = Astro.props;
const t = useTranslations(lang).matches;

const isQaMode = (env as { QA_MODE?: string })?.QA_MODE === 'true';
const qaUserId = (env as { QA_USER_ID?: string })?.QA_USER_ID || 'qa-test-user';
---

<Layout lang={lang} title={t.meta.title}>
  {isQaMode && <QaAuthInit client:load userId={qaUserId} />}
  <main>
      <div class="header-row rise">
        <div class="header-titles">
          <span class="eyebrow">{t.header.eyebrow}</span>
          <h1>{t.header.title}</h1>
        </div>
        <div class="header-actions">
          <a href="/stores/new" class="btn btn-outline btn-sm add-store-link">{t.header.addStore}</a>
          {!isQaMode && <UserButton />}
        </div>
      </div>

      <PromptIsland client:idle context="matches" lang={lang} />

      <MatchMapIsland client:load lang={lang} />
    </main>
</Layout>

<style>
  main {
    max-width: var(--maxw);
  }

  .header-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--s-4);
    flex-wrap: wrap;
    margin-bottom: var(--s-5);
  }

  .header-titles {
    display: flex;
    flex-direction: column;
    gap: var(--s-1);
  }

  h1 {
    margin: 0;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--s-4);
  }

  .add-store-link {
    text-decoration: none;
  }
</style>
