---
import { UserButton } from '@clerk/astro/components';

const runtime = Astro.locals.runtime as { env?: { QA_MODE?: string } } | undefined;
const isQaMode = runtime?.env?.QA_MODE === 'true';
---

{isQaMode ? (
  <div class="qa-user-badge" title="QA Test User">
    <span class="avatar">QA</span>
  </div>
) : (
  <UserButton />
)}

<style>
  .qa-user-badge {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .avatar {
    width: 36px;
    height: 36px;
    border-radius: var(--r-full);
    background: var(--accent);
    color: var(--accent-on);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
    font-weight: 640;
    letter-spacing: 0.02em;
    font-family: var(--font-ui);
    box-shadow: var(--shadow-1);
  }
</style>
