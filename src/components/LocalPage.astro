---
import Layout from '../layouts/Layout.astro';
import LocalDiscovery from './LocalDiscovery.svelte';
import PromptIsland from './PromptIsland.svelte';
import { UserButton } from '@clerk/astro/components';
import { env } from 'cloudflare:workers';
import { useTranslations, type Lang } from '../i18n';

interface Props {
  lang?: Lang;
}
const { lang = 'en' } = Astro.props;
const t = useTranslations(lang).matches;

const isQaMode = (env as { QA_MODE?: string })?.QA_MODE === 'true';
---

<Layout lang={lang} title={t.meta.title}>
  <main>
      <div class="header-row rise">
        <div class="header-titles">
          <span class="eyebrow">{t.header.eyebrow}</span>
          <h1>{t.header.title}</h1>
        </div>
        <div class="header-actions">
          <a href="/stores/new" class="btn btn-outline btn-sm add-store-link">{t.header.addStore}</a>
          {!isQaMode && <UserButton />}
        </div>
      </div>

      <LocalDiscovery client:load lang={lang} />

      <!-- Discovery is the page's job. Keep the optional profile prompt after
           its first useful results, especially on a small screen. -->
      <div class="profile-prompt">
        <PromptIsland client:idle context="matches" lang={lang} />
      </div>
    </main>
</Layout>

<style>
  main {
    max-width: var(--maxw);
  }

  .header-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--s-4);
    flex-wrap: wrap;
    margin-bottom: var(--s-5);
  }

  .header-titles {
    display: flex;
    flex-direction: column;
    gap: var(--s-1);
  }

  h1 {
    margin: 0;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--s-4);
  }

  .add-store-link {
    text-decoration: none;
  }

  .profile-prompt {
    margin-top: var(--s-6);
  }
</style>
