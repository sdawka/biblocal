---
const steps = [
  {
    number: "01",
    title: "Confess your shelf",
    description: "Scan a barcode or type it in. Add the books that made you who you are. Yes, even that one.",
    note: "No judgment. Probably."
  },
  {
    number: "02",
    title: "Declare your intentions",
    description: "Will you lend it? Debate it? Give it away? Hunt for it? Your shelf, your rules.",
    note: "Owning a book ≠ sharing it (and that's okay)"
  },
  {
    number: "03",
    title: "Find your people",
    description: "We match you with nearby humans whose shelves suggest they'd understand your references.",
    note: "The algorithm is clever. The humans are better."
  }
];
---

<section class="how-section">
  <div class="section-content">
    <h2 class="section-title">The ritual is simple</h2>

    <div class="steps-container">
      {steps.map((step, i) => (
        <div class="step-card" style={`--delay: ${0.1 + i * 0.15}s`}>
          <div class="step-number">{step.number}</div>
          <div class="step-content">
            <h3 class="step-title">{step.title}</h3>
            <p class="step-desc">{step.description}</p>
            <span class="step-note">{step.note}</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .how-section {
    padding: var(--space-2xl) var(--space-2xl) calc(var(--space-2xl) * 2);
    background: var(--color-parchment);
  }

  .section-content {
    max-width: 900px;
    margin: 0 auto;
  }

  .section-title {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3.5vw, 2rem);
    font-weight: 600;
    color: var(--color-ink);
    text-align: center;
    margin: 0 0 var(--space-2xl);
  }

  .steps-container {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .step-card {
    display: flex;
    gap: var(--space-lg);
    background: var(--color-cream);
    border: 1px solid var(--color-gold-pale);
    border-radius: var(--radius-md);
    padding: var(--space-lg) var(--space-xl);
    position: relative;
    box-shadow: var(--shadow-card);
    opacity: 0;
    transform: translateY(20px);
    animation: slideUp 0.6s cubic-bezier(0.4, 0, 0.2, 1) forwards;
    animation-delay: var(--delay);
  }

  .step-card::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    background: linear-gradient(
      to bottom,
      var(--color-gold),
      var(--color-gold-light)
    );
    border-radius: var(--radius-md) 0 0 var(--radius-md);
  }

  .step-number {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 700;
    color: var(--color-gold);
    opacity: 0.6;
    line-height: 1;
    flex-shrink: 0;
    width: 50px;
  }

  .step-content {
    flex: 1;
  }

  .step-title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-ink);
    margin: 0 0 var(--space-sm);
  }

  .step-desc {
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--color-ink-faded);
    margin: 0 0 var(--space-sm);
    line-height: 1.6;
  }

  .step-note {
    font-family: var(--font-handwritten);
    font-size: 1rem;
    color: var(--color-ink-light);
    display: inline-block;
    transform: rotate(-1deg);
  }

  @keyframes slideUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 600px) {
    .step-card {
      flex-direction: column;
      gap: var(--space-sm);
      padding: var(--space-md);
    }

    .step-number {
      font-size: 1.5rem;
    }
  }
</style>
