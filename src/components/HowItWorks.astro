---
const steps = [
  {
    number: "01",
    title: "Confess your shelf",
    description: "Scan a barcode or type it in. Add the books that made you who you are. Yes, even that one.",
    note: "No judgment. Probably."
  },
  {
    number: "02",
    title: "Declare your intentions",
    description: "Will you lend it? Debate it? Give it away? Hunt for it? Your shelf, your rules.",
    note: "Owning a book ≠ sharing it (and that's okay)"
  },
  {
    number: "03",
    title: "Find your people",
    description: "We match you with nearby humans whose shelves suggest they'd understand your references.",
    note: "The algorithm is clever. The humans are better."
  }
];
---

<section class="how-section">
  <div class="section-content">
    <h2 class="section-title">The ritual is simple</h2>

    <div class="steps-container">
      {steps.map((step, i) => (
        <div class="step-card" style={`--delay: ${0.1 + i * 0.15}s`}>
          <div class="step-number">{step.number}</div>
          <div class="step-content">
            <h3 class="step-title">{step.title}</h3>
            <p class="step-desc">{step.description}</p>
            <span class="step-note">{step.note}</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .how-section {
    padding: var(--s-10) var(--s-6) var(--s-12);
    background: var(--canvas);
  }

  .section-content {
    max-width: 900px;
    margin: 0 auto;
  }

  .section-title {
    font-size: clamp(1.6rem, 3.5vw, 2rem);
    text-align: center;
    margin: 0 0 var(--s-10);
  }

  .steps-container {
    display: flex;
    flex-direction: column;
    gap: var(--s-5);
  }

  .step-card {
    display: flex;
    gap: var(--s-5);
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: var(--r-lg);
    padding: var(--s-5) var(--s-6);
    position: relative;
    box-shadow: var(--shadow-1);
    opacity: 0;
    transform: translateY(20px);
    animation: hiwSlideUp var(--dur-3) var(--ease-out) forwards;
    animation-delay: var(--delay);
  }

  .step-card::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    background: var(--accent);
    border-radius: var(--r-lg) 0 0 var(--r-lg);
  }

  .step-number {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 600;
    color: var(--accent);
    opacity: 0.7;
    line-height: 1;
    flex-shrink: 0;
    width: 50px;
  }

  .step-content {
    flex: 1;
  }

  .step-title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 500;
    color: var(--ink);
    margin: 0 0 var(--s-2);
  }

  .step-desc {
    font-family: var(--font-ui);
    font-size: 1rem;
    color: var(--ink-muted);
    margin: 0 0 var(--s-2);
    line-height: 1.6;
  }

  .step-note {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1rem;
    color: var(--ink-faint);
    display: inline-block;
  }

  @keyframes hiwSlideUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 600px) {
    .step-card {
      flex-direction: column;
      gap: var(--s-2);
      padding: var(--s-4);
    }

    .step-number {
      font-size: 1.5rem;
    }
  }
</style>
