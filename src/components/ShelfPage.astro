---
import Layout from '../layouts/Layout.astro';
import AddBookIsland from './AddBookIsland.svelte';
import ImportIsland from './ImportIsland.svelte';
import ShelfContainer from './ShelfContainer.svelte';
import PromptIsland from './PromptIsland.svelte';
import SyncErrorToast from './SyncErrorToast.svelte';
import QaAuthInit from './QaAuthInit.svelte';
import { UserButton } from '@clerk/astro/components';
import { env } from 'cloudflare:workers';
import { useTranslations, type Lang } from '../i18n';

interface Props {
  lang?: Lang;
}
const { lang = 'en' } = Astro.props;
const t = useTranslations(lang).shelf;

const isQaMode = (env as { QA_MODE?: string })?.QA_MODE === 'true';
const qaUserId = (env as { QA_USER_ID?: string })?.QA_USER_ID || 'qa-test-user';
---

<Layout lang={lang} title={t.page.metaTitle}>
  {isQaMode && <QaAuthInit client:load userId={qaUserId} />}
  <main>
      <div class="header-row rise">
        <div class="header-text">
          <p class="eyebrow">{t.page.eyebrow}</p>
          <h1>{t.page.title}</h1>
        </div>
        {!isQaMode && <UserButton />}
      </div>

      <SyncErrorToast lang={lang} client:load />

      <PromptIsland lang={lang} client:idle context="shelf" />

      <section class="compose rise rise-1" aria-labelledby="add-book-title">
        <h2 id="add-book-title" class="zone-title">{t.page.zoneTitle}</h2>

        <div class="add-book-section">
          <AddBookIsland lang={lang} client:load />
        </div>

        <details class="import-section">
        <summary>
          <span class="summary-chevron" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3.5 5.5 7 9l3.5-3.5" />
            </svg>
          </span>
          {t.page.importSummary}
        </summary>
        <div class="import-body">
          <ImportIsland lang={lang} client:visible />
        </div>
      </details>
      </section>

      <ShelfContainer lang={lang} client:idle />
    </main>
</Layout>

<style>
  .header-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--s-4);
    margin-bottom: var(--s-5);
  }

  .header-text .eyebrow {
    margin: 0 0 var(--s-2);
  }

  .header-text h1 {
    margin: 0;
  }

  /* The "Add a book" zone: a distinct sunken panel so it reads as a separate
     area from the bookshelf list below, which matters most on mobile where the
     two would otherwise stack into one undifferentiated column. */
  .compose {
    margin-bottom: var(--s-7);
    padding: var(--s-5);
    background: var(--surface-sunken);
    border: 1px solid var(--hairline);
    border-radius: var(--r-lg);
  }

  .zone-title {
    margin: 0 0 var(--s-4);
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 500;
    color: var(--ink);
  }

  .import-section {
    margin: var(--s-4) 0 0;
  }

  @media (max-width: 600px) {
    .compose {
      padding: var(--s-4);
      margin-bottom: var(--s-6);
    }
  }

  .import-section summary {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    padding: 0.6rem 1.05rem;
    min-height: 44px;
    font-family: var(--font-ui);
    font-size: 0.9375rem;
    font-weight: 590;
    letter-spacing: -0.01em;
    color: var(--ink);
    background: var(--surface);
    border: 1px solid var(--hairline-strong);
    border-radius: var(--r-full);
    cursor: pointer;
    transition: border-color var(--dur-2) var(--ease-out), color var(--dur-2) var(--ease-out);
    list-style: none;
  }

  .import-section summary::-webkit-details-marker {
    display: none;
  }

  .summary-chevron {
    display: inline-flex;
    color: var(--ink-muted);
    transition: transform var(--dur-2) var(--ease-spring);
  }

  .import-section[open] .summary-chevron {
    transform: rotate(180deg);
  }

  .import-section summary:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .import-section[open] .import-body {
    margin-top: var(--s-4);
    animation: rise var(--dur-3) var(--ease-out) both;
  }
</style>
