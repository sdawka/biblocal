---
const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer-content">
    <div class="footer-left">
      <span class="copyright">© {currentYear} <a href="https://sahil.pro" target="_blank" rel="noopener">sahil.pro</a></span>
    </div>
    <div class="footer-center">
      <a href="/about" class="footer-link">About</a>
      <span class="footer-divider">·</span>
      <a href="/how-it-works" class="footer-link">How It Works</a>
    </div>
    <div class="footer-right">
      <a href="mailto:me@sahil.pro" class="contact-link">me@sahil.pro</a>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding: var(--s-6) var(--s-6);
    background: var(--surface-sunken);
    border-top: 1px solid var(--hairline);
  }

  .footer-content {
    max-width: var(--maxw);
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--s-4);
  }

  .copyright,
  .contact-link,
  .footer-link {
    font-family: var(--font-ui);
    font-size: 0.85rem;
    color: var(--ink-muted);
  }

  .copyright a,
  .contact-link,
  .footer-link {
    text-decoration: none;
    transition: color var(--dur-1) var(--ease-soft);
  }

  .copyright a { color: var(--accent); }
  .copyright a:hover,
  .contact-link:hover,
  .footer-link:hover {
    color: var(--accent-hover);
  }

  .footer-center {
    display: flex;
    align-items: center;
    gap: var(--s-3);
  }

  .footer-divider {
    color: var(--ink-faint);
  }

  @media (max-width: 500px) {
    .footer-content {
      flex-direction: column;
      text-align: center;
    }
  }
</style>
