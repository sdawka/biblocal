---
const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer-inner">
    <div class="brand">
      <a href="/" class="wordmark">biblocal</a>
      <p class="tagline">A living bookshelf, shared with the readers around you.</p>
    </div>

    <nav class="cols" aria-label="Footer">
      <div class="col">
        <h2 class="col-head">Explore</h2>
        <a href="/about">About</a>
        <a href="/how-it-works">How it works</a>
      </div>
      <div class="col">
        <h2 class="col-head">Connect</h2>
        <a href="mailto:me@sahil.pro">me@sahil.pro</a>
        <a href="https://sahil.pro" target="_blank" rel="noopener">sahil.pro</a>
      </div>
    </nav>
  </div>

  <div class="baseline">
    <span class="copyright">© {currentYear} biblocal</span>
    <span class="made">
      Built by <a href="https://sahil.pro" target="_blank" rel="noopener">Sahil</a>
    </span>
  </div>
</footer>

<style>
  .footer {
    background: var(--surface-sunken);
    border-top: 1px solid var(--hairline);
    padding: clamp(3rem, 7vh, 4.5rem) clamp(1.25rem, 5vw, 5rem) var(--s-5);
  }

  .footer-inner {
    max-width: 1240px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    gap: var(--s-8);
    flex-wrap: wrap;
    padding-bottom: var(--s-7);
  }

  .brand { max-width: 22rem; }

  .wordmark {
    font-family: var(--font-display);
    font-size: 1.55rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--ink);
    text-decoration: none;
    transition: color var(--dur-1) var(--ease-soft);
  }
  .wordmark:hover { color: var(--accent); }

  .tagline {
    margin: var(--s-3) 0 0;
    font-family: var(--font-ui);
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--ink-muted);
  }

  .cols {
    display: flex;
    gap: clamp(2.5rem, 6vw, 5rem);
  }

  .col { display: flex; flex-direction: column; gap: var(--s-3); }

  .col-head {
    margin: 0 0 var(--s-1);
    font-family: var(--font-ui);
    font-size: 0.8rem;
    font-weight: 640;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .col a {
    font-family: var(--font-ui);
    font-size: 0.95rem;
    color: var(--ink-muted);
    text-decoration: none;
    width: fit-content;
    /* A little more vertical tap area without disturbing layout. */
    padding: 0.25rem 0;
    transition: color var(--dur-1) var(--ease-soft);
  }
  .col a:hover { color: var(--accent); }

  .baseline {
    max-width: 1240px;
    margin: 0 auto;
    padding-top: var(--s-5);
    border-top: 1px solid var(--hairline);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--s-3);
  }

  .copyright,
  .made {
    font-family: var(--font-ui);
    font-size: 0.82rem;
    color: var(--ink-faint);
  }
  .made a {
    color: var(--accent);
    text-decoration: none;
    transition: color var(--dur-1) var(--ease-soft);
  }
  .made a:hover { color: var(--accent-hover); }

  @media (max-width: 600px) {
    .footer-inner { flex-direction: column; gap: var(--s-7); }
    .baseline { flex-direction: column; align-items: flex-start; }
  }
</style>
