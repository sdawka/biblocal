---
const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer-content">
    <div class="footer-left">
      <span class="copyright">© {currentYear} <a href="https://sahil.pro" target="_blank" rel="noopener">sahil.pro</a></span>
    </div>
    <div class="footer-center">
      <a href="/about" class="footer-link">About</a>
      <span class="footer-divider">·</span>
      <a href="/how-it-works" class="footer-link">How It Works</a>
    </div>
    <div class="footer-right">
      <a href="mailto:me@sahil.pro" class="contact-link">me@sahil.pro</a>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding: var(--space-lg) var(--space-2xl);
    background: var(--color-mahogany-deep);
    border-top: 1px solid var(--color-mahogany);
  }

  .footer-content {
    max-width: 1100px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-md);
  }

  .copyright {
    font-family: var(--font-body);
    font-size: 0.85rem;
    color: var(--color-gold-pale);
  }

  .copyright a {
    color: var(--color-gold);
    text-decoration: none;
    transition: color var(--transition-quick);
  }

  .copyright a:hover {
    color: var(--color-gold-light);
  }

  .contact-link {
    font-family: var(--font-body);
    font-size: 0.85rem;
    color: var(--color-gold-pale);
    text-decoration: none;
    transition: color var(--transition-quick);
  }

  .contact-link:hover {
    color: var(--color-gold);
  }

  .footer-center {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .footer-link {
    font-family: var(--font-body);
    font-size: 0.85rem;
    color: var(--color-gold-pale);
    text-decoration: none;
    transition: color var(--transition-quick);
  }

  .footer-link:hover {
    color: var(--color-gold);
  }

  .footer-divider {
    color: var(--color-gold-pale);
    opacity: 0.5;
  }

  @media (max-width: 500px) {
    .footer-content {
      flex-direction: column;
      text-align: center;
    }
  }
</style>
