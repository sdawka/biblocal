---
import Layout from '../layouts/Layout.astro';
import AddBookIsland from '../components/AddBookIsland.svelte';
import ImportIsland from '../components/ImportIsland.svelte';
import ShelfContainer from '../components/ShelfContainer.svelte';
import PromptIsland from '../components/PromptIsland.svelte';
import SyncErrorToast from '../components/SyncErrorToast.svelte';
import QaAuthInit from '../components/QaAuthInit.svelte';
import { UserButton } from '@clerk/astro/components';
import { env } from 'cloudflare:workers';

const isQaMode = (env as { QA_MODE?: string })?.QA_MODE === 'true';
const qaUserId = (env as { QA_USER_ID?: string })?.QA_USER_ID || 'qa-test-user';
---

<Layout title="Your Shelf | biblocal">
  {isQaMode && <QaAuthInit client:load userId={qaUserId} />}
  <main>
      <div class="header-row rise">
        <div class="header-text">
          <p class="eyebrow">Your library</p>
          <h1>Your Shelf</h1>
        </div>
        {!isQaMode && <UserButton />}
      </div>

      <SyncErrorToast client:load />

      <PromptIsland client:idle context="shelf" />

      <div class="add-book-section rise rise-1">
        <AddBookIsland client:load />
      </div>

      <details class="import-section rise rise-2">
        <summary>
          <span class="summary-chevron" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3.5 5.5 7 9l3.5-3.5" />
            </svg>
          </span>
          Import from Goodreads
        </summary>
        <div class="import-body">
          <ImportIsland client:visible />
        </div>
      </details>

      <ShelfContainer client:idle />
    </main>
</Layout>

<style>
  .header-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--s-4);
    margin-bottom: var(--s-5);
  }

  .header-text .eyebrow {
    margin: 0 0 var(--s-2);
  }

  .header-text h1 {
    margin: 0;
  }

  .import-section {
    margin: var(--s-5) 0;
  }

  .import-section summary {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    padding: 0.6rem 1.05rem;
    min-height: 44px;
    font-family: var(--font-ui);
    font-size: 0.9375rem;
    font-weight: 590;
    letter-spacing: -0.01em;
    color: var(--ink);
    background: var(--surface);
    border: 1px solid var(--hairline-strong);
    border-radius: var(--r-full);
    cursor: pointer;
    transition: border-color var(--dur-2) var(--ease-out), color var(--dur-2) var(--ease-out);
    list-style: none;
  }

  .import-section summary::-webkit-details-marker {
    display: none;
  }

  .summary-chevron {
    display: inline-flex;
    color: var(--ink-muted);
    transition: transform var(--dur-2) var(--ease-spring);
  }

  .import-section[open] .summary-chevron {
    transform: rotate(180deg);
  }

  .import-section summary:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .import-section[open] .import-body {
    margin-top: var(--s-4);
    animation: rise var(--dur-3) var(--ease-out) both;
  }
</style>
