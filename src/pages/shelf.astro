---
import Layout from '../layouts/Layout.astro';
import AddBookIsland from '../components/AddBookIsland.svelte';
import ShelfContainer from '../components/ShelfContainer.svelte';
import PromptIsland from '../components/PromptIsland.svelte';
import QaAuthInit from '../components/QaAuthInit.svelte';
import { UserButton } from '@clerk/astro/components';
import { env } from 'cloudflare:workers';

const isQaMode = (env as { QA_MODE?: string })?.QA_MODE === 'true';
const qaUserId = (env as { QA_USER_ID?: string })?.QA_USER_ID || 'qa-test-user';
---

<Layout title="Your Shelf | biblocal">
  {isQaMode && <QaAuthInit client:load userId={qaUserId} />}
  <main>
      <div class="header-row">
        <h1>Your Shelf</h1>
        {!isQaMode && <UserButton />}
      </div>

      <PromptIsland client:load context="shelf" />

      <div class="add-book-section">
        <AddBookIsland client:load />
      </div>

      <ShelfContainer client:load />
    </main>
</Layout>

<style>
  .header-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
  }
</style>
