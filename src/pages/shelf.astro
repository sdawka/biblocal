---
import Layout from '../layouts/Layout.astro';
import AddBookIsland from '../components/AddBookIsland.svelte';
import ImportIsland from '../components/ImportIsland.svelte';
import ShelfContainer from '../components/ShelfContainer.svelte';
import PromptIsland from '../components/PromptIsland.svelte';
import QaAuthInit from '../components/QaAuthInit.svelte';
import { UserButton } from '@clerk/astro/components';
import { env } from 'cloudflare:workers';

const isQaMode = (env as { QA_MODE?: string })?.QA_MODE === 'true';
const qaUserId = (env as { QA_USER_ID?: string })?.QA_USER_ID || 'qa-test-user';
---

<Layout title="Your Shelf | biblocal">
  {isQaMode && <QaAuthInit client:load userId={qaUserId} />}
  <main>
      <div class="header-row">
        <h1>Your Shelf</h1>
        {!isQaMode && <UserButton />}
      </div>

      <PromptIsland client:idle context="shelf" />

      <div class="add-book-section">
        <AddBookIsland client:load />
      </div>

      <details class="import-section">
        <summary>Import from Goodreads</summary>
        <ImportIsland client:visible />
      </details>

      <ShelfContainer client:idle />
    </main>
</Layout>

<style>
  .header-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
  }

  .import-section {
    margin: 1rem 0;
  }

  .import-section summary {
    padding: 0.75rem 1rem;
    font-family: var(--font-display);
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--color-ink-faded);
    background: var(--color-paper);
    border: 1px solid var(--color-gold-pale);
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: all 0.15s ease;
    list-style: none;
  }

  .import-section summary::-webkit-details-marker {
    display: none;
  }

  .import-section summary::before {
    content: "+ ";
  }

  .import-section[open] summary::before {
    content: "- ";
  }

  .import-section summary:hover {
    border-color: var(--color-gold);
    color: var(--color-ink);
  }

  .import-section[open] summary {
    margin-bottom: 0.75rem;
  }
</style>
