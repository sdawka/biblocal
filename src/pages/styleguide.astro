---
// TEMPORARY foundation showcase — deleted before PR. Lets us screenshot the
// design-system core (light + dark) before redesigning real pages.
import Layout from '../layouts/Layout.astro';

const statuses = [
  'private', 'visible', 'borrowable', 'discussable',
  'giftable', 'class-resource', 'seeking-home',
];
---

<Layout title="biblocal — Style Guide">
  <main>
    <p class="eyebrow rise">Design system</p>
    <h1 class="rise rise-1">A warm, quiet library.</h1>
    <p class="muted rise rise-2" style="max-width: 52ch; font-size: 1.1rem;">
      Newsreader for the things you read, system type for the things you tap.
      Indigo accent, soft depth, spring motion — in light and dark.
    </p>

    <hr class="hr" />

    <h2 class="serif">Typography</h2>
    <div class="card" style="margin-bottom: var(--s-6);">
      <h1 style="margin-bottom: var(--s-2);">Crime and Punishment</h1>
      <h2 class="serif" style="margin-bottom: var(--s-2);">Fyodor Dostoevsky</h2>
      <h3 class="serif" style="margin-bottom: var(--s-4);">A chapter heading</h3>
      <p class="muted" style="margin: 0;">
        Body copy uses the native system font so it feels crisp and at home on every
        device — the way Apple's own apps do. Display text borrows Newsreader's
        editorial warmth without tipping into nostalgia.
      </p>
    </div>

    <h2 class="serif">Buttons</h2>
    <div class="row" style="gap: var(--s-3); flex-wrap: wrap; margin-bottom: var(--s-3);">
      <button class="btn btn-filled">Filled</button>
      <button class="btn btn-tinted">Tinted</button>
      <button class="btn btn-outline">Outline</button>
      <button class="btn btn-plain">Plain</button>
    </div>
    <div class="row" style="gap: var(--s-3); flex-wrap: wrap; margin-bottom: var(--s-6);">
      <button class="btn btn-filled btn-sm">Small</button>
      <button class="btn btn-filled">Medium</button>
      <button class="btn btn-filled btn-lg">Large</button>
    </div>

    <h2 class="serif">Segmented control</h2>
    <div class="segmented" style="margin-bottom: var(--s-6);">
      <button class="active">All</button>
      <button>Owned</button>
      <button>Lending</button>
      <button>Seeking</button>
    </div>

    <h2 class="serif">Status pills</h2>
    <div class="row" style="gap: var(--s-2); flex-wrap: wrap; margin-bottom: var(--s-6);">
      {statuses.map((s) => <span class="pill" data-status={s}>{s}</span>)}
    </div>

    <h2 class="serif">Fields</h2>
    <div class="card" style="display: grid; gap: var(--s-4); max-width: 480px; margin-bottom: var(--s-6);">
      <div>
        <label class="label" for="t">Title</label>
        <input class="input" id="t" placeholder="The Brothers Karamazov" />
      </div>
      <div>
        <label class="label" for="s">Status</label>
        <select class="select" id="s">
          <option>Borrowable</option>
          <option>Discussable</option>
          <option>Giftable</option>
        </select>
      </div>
      <div>
        <label class="label" for="n">Note</label>
        <textarea class="textarea" id="n" placeholder="Why this one matters to you…"></textarea>
      </div>
    </div>

    <h2 class="serif">Cards</h2>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: var(--s-4); margin-bottom: var(--s-8);">
      <div class="card card-interactive">
        <span class="pill" data-status="borrowable">borrowable</span>
        <h3 class="serif" style="margin: var(--s-3) 0 var(--s-1);">Dune</h3>
        <p class="muted" style="margin: 0; font-size: 0.9rem;">Frank Herbert · happy to lend</p>
      </div>
      <div class="card card-interactive">
        <span class="pill" data-status="discussable">discussable</span>
        <h3 class="serif" style="margin: var(--s-3) 0 var(--s-1);">Gödel, Escher, Bach</h3>
        <p class="muted" style="margin: 0; font-size: 0.9rem;">Douglas Hofstadter · let's talk</p>
      </div>
      <div class="card card-interactive">
        <span class="pill" data-status="seeking-home">seeking-home</span>
        <h3 class="serif" style="margin: var(--s-3) 0 var(--s-1);">The Recognitions</h3>
        <p class="muted" style="margin: 0; font-size: 0.9rem;">William Gaddis · hunting a copy</p>
      </div>
    </div>
  </main>
</Layout>
