---
import Layout from '../../layouts/Layout.astro';
import StoreDetailIsland from '../../components/StoreDetailIsland.svelte';
import { Show, UserButton } from '@clerk/astro/components';
import { env } from 'cloudflare:workers';

const { id } = Astro.params;
const isQaMode = (env as { QA_MODE?: string })?.QA_MODE === 'true';
---

<Layout title="Bookstore | biblocal">
  {isQaMode ? (
    <main>
      <div class="header-row rise">
        <a href="/matches" class="back-link">← Back to matches</a>
      </div>
      <div class="rise rise-1">
        <StoreDetailIsland storeId={id!} client:load />
      </div>
    </main>
  ) : (
    <>
      <Show when="signed-out">
        <script>window.location.href = '/';</script>
      </Show>
      <Show when="signed-in">
        <main>
          <div class="header-row rise">
            <a href="/matches" class="back-link">← Back to matches</a>
            <UserButton />
          </div>
          <div class="rise rise-1">
            <StoreDetailIsland storeId={id!} client:load />
          </div>
        </main>
      </Show>
    </>
  )}
</Layout>

<style>
  .header-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--s-6);
  }

  .back-link {
    font-family: var(--font-ui);
    font-size: 0.9rem;
    font-weight: 540;
    color: var(--ink-muted);
    text-decoration: none;
    padding: 0.4rem 0;
    transition: color var(--dur-1) var(--ease-soft);
  }

  .back-link:hover {
    color: var(--accent);
  }
</style>
