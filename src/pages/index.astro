---
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.svelte';
import BookshelfDemo from '../components/BookshelfDemo.svelte';
import FacetShowcase from '../components/FacetShowcase.svelte';
import LocalMapPreview from '../components/LocalMapPreview.svelte';
import HowItWorks from '../components/HowItWorks.astro';
import SignInSection from '../components/SignInSection.astro';
import Footer from '../components/Footer.astro';
---

<LandingLayout title="biblocal — Find your people through what you read">
  <main>
    <LandingHero client:load />
    <BookshelfDemo client:visible />
    <FacetShowcase client:visible />
    <LocalMapPreview client:visible />
    <HowItWorks />
    <SignInSection />
    <Footer />
  </main>
</LandingLayout>

<style>
  main {
    max-width: none;
    margin: 0;
    padding: 0;
  }
</style>
