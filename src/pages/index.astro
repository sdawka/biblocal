---
import Layout from '../layouts/Layout.astro';
import { SignIn, Show } from '@clerk/astro/components';
---

<Layout title="biblocal - Sign in">
  <main class="login-page">
    <div class="hero">
      <h1>biblocal</h1>
      <p>Build your living bookshelf. Find people nearby with similar taste.</p>
    </div>

    <Show when="signed-out">
      <SignIn />
    </Show>

    <Show when="signed-in">
      <p class="redirect-msg">Redirecting to your shelf...</p>
      <script>window.location.href = '/shelf';</script>
    </Show>
  </main>
</Layout>

<style>
  .login-page {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 2rem;
  }

  .hero {
    text-align: center;
    margin-bottom: 2rem;
  }

  .hero h1 {
    font-family: var(--font-display);
    font-size: 3rem;
    font-weight: 700;
    font-style: italic;
    color: var(--color-burgundy);
    margin: 0 0 0.5rem;
  }

  .hero p {
    font-family: var(--font-body);
    font-size: 1.1rem;
    color: var(--color-ink-faded);
    margin: 0;
  }

  .redirect-msg {
    font-family: var(--font-body);
    color: var(--color-ink-faded);
    font-style: italic;
  }
</style>
