---
import Layout from '../layouts/Layout.astro';
import MatchMapIsland from '../components/MatchMapIsland.svelte';
import PromptIsland from '../components/PromptIsland.svelte';
import QaAuthInit from '../components/QaAuthInit.svelte';
import { UserButton } from '@clerk/astro/components';
import { env } from 'cloudflare:workers';

const isQaMode = (env as { QA_MODE?: string })?.QA_MODE === 'true';
const qaUserId = (env as { QA_USER_ID?: string })?.QA_USER_ID || 'qa-test-user';
---

<Layout title="Find Matches | biblocal">
  {isQaMode && <QaAuthInit client:load userId={qaUserId} />}
  <main>
      <div class="header-row rise">
        <div class="header-titles">
          <span class="eyebrow">Discover</span>
          <h1>Nearby</h1>
        </div>
        <div class="header-actions">
          <a href="/stores/new" class="btn btn-outline btn-sm add-store-link">+ Add a bookstore</a>
          {!isQaMode && <UserButton />}
        </div>
      </div>

      <PromptIsland client:idle context="matches" />

      <MatchMapIsland client:load />
    </main>
</Layout>

<style>
  main {
    max-width: var(--maxw);
  }

  .header-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--s-4);
    flex-wrap: wrap;
    margin-bottom: var(--s-5);
  }

  .header-titles {
    display: flex;
    flex-direction: column;
    gap: var(--s-1);
  }

  h1 {
    margin: 0;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--s-4);
  }

  .add-store-link {
    text-decoration: none;
  }
</style>
