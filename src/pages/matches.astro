---
import Layout from '../layouts/Layout.astro';
import MatchMapIsland from '../components/MatchMapIsland.svelte';
import PromptIsland from '../components/PromptIsland.svelte';
import { UserButton } from '@clerk/astro/components';
---

<Layout title="Find Matches | biblocal">
  <main>
      <div class="header-row">
        <h1>Nearby</h1>
        <div class="header-actions">
          <a href="/stores/new" class="add-store-link">+ Add a bookstore</a>
          <UserButton />
        </div>
      </div>

      <PromptIsland client:load context="matches" />

      <MatchMapIsland client:load />
    </main>
</Layout>

<style>
  main {
    max-width: none;
  }

  .header-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
  }

  h1 {
    margin: 0;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .add-store-link {
    font-family: var(--font-body);
    font-size: 0.85rem;
    color: var(--color-burgundy, #722f37);
    text-decoration: none;
    padding: 0.375rem 0.75rem;
    border: 1px solid var(--color-burgundy, #722f37);
    border-radius: var(--radius-sm);
    transition: all var(--transition-quick);
  }

  .add-store-link:hover {
    background: var(--color-burgundy, #722f37);
    color: var(--color-cream);
  }
</style>
