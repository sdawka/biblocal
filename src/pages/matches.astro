---
import Layout from '../layouts/Layout.astro';
import MatchMapIsland from '../components/MatchMapIsland.svelte';
import PromptIsland from '../components/PromptIsland.svelte';
import { Show, UserButton } from '@clerk/astro/components';
---

<Layout title="Find Matches | biblocal">
  <Show when="signed-out">
    <script>window.location.href = '/';</script>
  </Show>
  <Show when="signed-in">
    <main>
      <div class="header-row">
        <h1>People Nearby</h1>
        <UserButton />
      </div>

      <PromptIsland client:load context="matches" />

      <MatchMapIsland client:load />
    </main>
  </Show>
</Layout>

<style>
  main {
    max-width: none;
  }

  .header-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
  }

  h1 {
    margin: 0;
  }
</style>
