{
	"compatibility_date": "2026-05-05",
	"compatibility_flags": ["global_fetch_strictly_public", "nodejs_compat"],
	"name": "biblocal",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "biblocal-db",
			"database_id": "e03824d4-940a-4679-8ffa-51b7d1898f47"
		}
	],
	"send_email": [
		{
			"name": "EMAIL"
		}
	]
}