{
	"compatibility_date": "2026-05-05",
	"compatibility_flags": ["nodejs_compat", "disable_nodejs_process_v2"],
	"name": "biblocal",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"vars": {
		"PUBLIC_CLERK_PUBLISHABLE_KEY": "pk_test_aHVtYW5lLWxvbmdob3JuLTY2LmNsZXJrLmFjY291bnRzLmRldiQ"
	},
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "biblocal-db",
			"database_id": "e03824d4-940a-4679-8ffa-51b7d1898f47"
		}
	]
}