{
  "name": "biblocal",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:qa": "QA_MODE=true QA_USER_ID=qa-test-user astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "deploy:qa": "bash scripts/deploy-qa.sh",
    "seed:qa": "wrangler d1 execute biblocal-qa-db --env qa --file=scripts/seed-qa.sql",
    "qa:scenario": "bash scripts/qa-scenario.sh",
    "generate-types": "wrangler types",
    "seed:stores": "curl -X POST http://localhost:4321/api/seed-stores"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^13.3.1",
    "@astrojs/mdx": "^6.0.3",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/svelte": "^8.1.0",
    "@clerk/astro": "^3.2.2",
    "@ericblade/quagga2": "^1.12.1",
    "@nanostores/persistent": "^1.3.4",
    "astro": "^6.2.2",
    "drizzle-orm": "^0.45.2",
    "leaflet": "^1.9.4",
    "mimetext": "^3.0.28",
    "nanostores": "^1.3.0",
    "svelte": "^5.55.5",
    "typescript": "^5.9.3",
    "wrangler": "^4.88.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@cloudflare/workers-types": "^4.20260505.1",
    "@testing-library/svelte": "^5.3.1",
    "@types/leaflet": "^1.9.21",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^29.1.1",
    "playwright": "^1.60.0",
    "vitest": "^4.1.5"
  },
  "overrides": {
    "vite": "^7"
  }
}
